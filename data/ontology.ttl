uc:instr_other a skos:Concept, uc:FlowInstrument ;
    skos:inScheme uc:FlowInstrumentScheme ; skos:topConceptOf uc:FlowInstrumentScheme ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en , "Otro"@es ;
    rdfs:label "Other"@en , "Otro"@es ;
    skos:definition "Any other or unspecified instrument."@en , "Cualquier otro instrumento o no especificado."@es ;
    rdfs:comment "Any other or unspecified instrument."@en , "Cualquier otro instrumento o no especificado."@es .

uc:EventCategoryScheme a skos:ConceptScheme ;
    skos:prefLabel "Event categories"@en , "Categorías de evento"@es ;
    rdfs:label "Event categories"@en , "Categorías de evento"@es ;
    rdfs:comment "Controlled vocabulary; each concept carries the SPEC.md enumeration string in skos:notation."@en ,
        "Vocabulario controlado; cada concepto lleva en skos:notation la cadena de enumeración de SPEC.md."@es ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:EventCategory a owl:Class ;
    rdfs:label "event category"@en , "categoría de evento"@es ;
    rdfs:comment "Class of the concepts in uc:EventCategoryScheme."@en ,
        "Clase de los conceptos de uc:EventCategoryScheme."@es ;
    rdfs:subClassOf skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:cat_corporate a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "corporate" ;
    skos:prefLabel "Corporate"@en , "Societario"@es ;
    rdfs:label "Corporate"@en , "Societario"@es ;
    skos:definition "Incorporations, share transfers, board changes, mergers."@en , "Constituciones, transferencias de acciones, cambios de directorio, fusiones."@es ;
    rdfs:comment "Incorporations, share transfers, board changes, mergers."@en , "Constituciones, transferencias de acciones, cambios de directorio, fusiones."@es .

uc:cat_credit a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "credit" ;
    skos:prefLabel "Credit"@en , "Crediticio"@es ;
    rdfs:label "Credit"@en , "Crediticio"@es ;
    skos:definition "Loans granted, renewed, repaid or sold."@en , "Préstamos otorgados, renovados, cancelados o vendidos."@es ;
    rdfs:comment "Loans granted, renewed, repaid or sold."@en , "Préstamos otorgados, renovados, cancelados o vendidos."@es .

uc:cat_supervisory a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "supervisory" ;
    skos:prefLabel "Supervisory"@en , "Supervisión"@es ;
    rdfs:label "Supervisory"@en , "Supervisión"@es ;
    skos:definition "Inspections, findings, sanctions and other acts of the financial supervisors."@en , "Inspecciones, hallazgos, sanciones y otros actos de los supervisores financieros."@es ;
    rdfs:comment "Inspections, findings, sanctions and other acts of the financial supervisors."@en , "Inspecciones, hallazgos, sanciones y otros actos de los supervisores financieros."@es .

uc:cat_criminal a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "criminal" ;
    skos:prefLabel "Criminal proceedings"@en , "Proceso penal"@es ;
    rdfs:label "Criminal proceedings"@en , "Proceso penal"@es ;
    skos:definition "Complaints, charges, hearings and measures in the criminal case."@en , "Denuncias, imputaciones, audiencias y medidas en la causa penal."@es ;
    rdfs:comment "Complaints, charges, hearings and measures in the criminal case."@en , "Denuncias, imputaciones, audiencias y medidas en la causa penal."@es .

uc:cat_political a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "political" ;
    skos:prefLabel "Political"@en , "Político"@es ;
    rdfs:label "Political"@en , "Político"@es ;
    skos:definition "Acts and statements of political bodies and office holders."@en , "Actos y declaraciones de órganos políticos y funcionarios."@es ;
    rdfs:comment "Acts and statements of political bodies and office holders."@en , "Actos y declaraciones de órganos políticos y funcionarios."@es .

uc:cat_market a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "market" ;
    skos:prefLabel "Market"@en , "Mercado"@es ;
    rdfs:label "Market"@en , "Mercado"@es ;
    skos:definition "Ratings, bond issues, market reactions."@en , "Calificaciones, emisiones de bonos, reacciones del mercado."@es ;
    rdfs:comment "Ratings, bond issues, market reactions."@en , "Calificaciones, emisiones de bonos, reacciones del mercado."@es .

uc:cat_statement a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "statement" ;
    skos:prefLabel "Statement"@en , "Declaración"@es ;
    rdfs:label "Statement"@en , "Declaración"@es ;
    skos:definition "Public statements by the parties."@en , "Declaraciones públicas de las partes."@es ;
    rdfs:comment "Public statements by the parties."@en , "Declaraciones públicas de las partes."@es .

uc:cat_depositor a skos:Concept, uc:EventCategory ;
    skos:inScheme uc:EventCategoryScheme ; skos:topConceptOf uc:EventCategoryScheme ;
    skos:notation "depositor" ;
    skos:prefLabel "Depositor"@en , "Depositantes"@es ;
    rdfs:label "Depositor"@en , "Depositantes"@es ;
    skos:definition "Events affecting depositors: withdrawals, guarantees, communications."@en , "Hechos que afectan a los depositantes: retiros, garantías, comunicados."@es ;
    rdfs:comment "Events affecting depositors: withdrawals, guarantees, communications."@en , "Hechos que afectan a los depositantes: retiros, garantías, comunicados."@es .

# -----------------------------------------------------------------------------
# Named graphs
# -----------------------------------------------------------------------------

<https://w3id.org/ueno-case/id/graph/prosecution> a uc:AssertionGraph ;
    rdfs:label "Prosecution assertions graph"@en , "Grafo de aserciones del Ministerio Público"@es ;
    rdfs:comment "Named graph holding the assertions by uc:Prosecution that were read in the prosecution record itself (source src:acta-pNN), together with their shortcut triples. Prosecution claims reported second-hand are in the press graph."@en ,
        "Grafo con nombre que contiene las aserciones de uc:Prosecution leídas en la propia acta fiscal (fuente src:acta-pNN), junto con sus triples de atajo. Las afirmaciones de la Fiscalía conocidas de segunda mano están en el grafo de prensa."@es ;
    prov:wasAttributedTo uc:Prosecution .

<https://w3id.org/ueno-case/id/graph/rey> a uc:AssertionGraph ;
    rdfs:label "Suspect (Rey) assertions graph"@en , "Grafo de aserciones del imputado (Rey)"@es ;
    rdfs:comment "Named graph holding the assertions by uc:Rey that were read in the prosecution record itself (source src:acta-pNN), together with their shortcut triples. Statements by Rey reported second-hand are in the press graph."@en ,
        "Grafo con nombre que contiene las aserciones de uc:Rey leídas en la propia acta fiscal (fuente src:acta-pNN), junto con sus triples de atajo. Las declaraciones de Rey conocidas de segunda mano están en el grafo de prensa."@es ;
    prov:wasAttributedTo uc:Rey .

<https://w3id.org/ueno-case/id/graph/press> a uc:AssertionGraph ;
    rdfs:label "Press assertions graph"@en , "Grafo de aserciones de la prensa"@es ;
    rdfs:comment "Named graph holding every assertion that was not read in the prosecution record: press, regulator, rating agency, company, defence and analyst voices, and prosecution or Rey claims reported second-hand. uc:assertedBy names the exact voice."@en ,
        "Grafo con nombre que contiene toda aserción no leída en el acta fiscal: voces de prensa, regulador, calificadora, empresa, defensa y analista, y las afirmaciones de la Fiscalía o de Rey conocidas de segunda mano. uc:assertedBy indica la voz exacta."@es ;
    prov:wasAttributedTo uc:Press .

# -----------------------------------------------------------------------------
# Terms added in v0.2.0 (20 Nov 2026): builder terms moved into the ontology, editor layer,
# source tier, same-operation grouping, charge details
# -----------------------------------------------------------------------------

uc:PartyDescription a owl:Class ;
    rdfs:label "party description"@en , "descripción de parte"@es ;
    rdfs:comment "One contributor row describing a party (label, alternative names, description, business), with its own provenance. uc:involvesParty points at the party described."@en ,
        "Fila de un colaborador que describe a una parte (nombre, nombres alternativos, descripción, actividad), con su propia procedencia. uc:involvesParty apunta a la parte descrita."@es ;
    rdfs:subClassOf uc:Assertion ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:Correction a owl:Class ;
    rdfs:label "correction"@en , "corrección"@es ;
    rdfs:comment "A record of one editorial correction to a contributor row: field, value before, value after, reason and the source it relies on. Not a claim about the case."@en ,
        "Registro de una corrección editorial a una fila de un colaborador: campo, valor anterior, valor nuevo, motivo y fuente en que se apoya. No es una afirmación sobre el caso."@es ;
    rdfs:subClassOf prov:Entity ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:business a owl:DatatypeProperty ;
    rdfs:label "business"@en , "actividad"@es ;
    rdfs:comment "What the party does (line of business), as described by a contributor."@en ,
        "A qué se dedica la parte (giro), según la describe un colaborador."@es ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:isStub a owl:DatatypeProperty ;
    rdfs:label "is stub"@en , "es marcador"@es ;
    rdfs:comment "true on a party that assertions refer to but no contributor has described yet; its label is only a placeholder made from the id."@en ,
        "true en una parte a la que se refieren aserciones pero que ningún colaborador ha descrito aún; su etiqueta es solo un marcador derivado del identificador."@es ;
    rdfs:domain uc:Party ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:dateText a owl:DatatypeProperty ;
    rdfs:label "date as written"@en , "fecha tal como se escribió"@es ;
    rdfs:comment "The date or period string exactly as the contributor wrote it."@en ,
        "La fecha o el periodo exactamente como lo escribió el colaborador."@es ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:sortDate a owl:DatatypeProperty ;
    rdfs:label "sort date"@en , "fecha de ordenación"@es ;
    rdfs:comment "First day of the stated date or period, for sorting. Not a claim of day precision: see uc:datePrecision."@en ,
        "Primer día de la fecha o periodo indicados, para ordenar. No implica precisión de día: véase uc:datePrecision."@es ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:sortDateEnd a owl:DatatypeProperty ;
    rdfs:label "sort date (end)"@en , "fecha de ordenación (fin)"@es ;
    rdfs:comment "Last day of the end of a period or role, for sorting."@en ,
        "Último día del fin de un periodo o rol, para ordenar."@es ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:startDateText a owl:DatatypeProperty ;
    rdfs:label "start as written"@en , "inicio tal como se escribió"@es ;
    rdfs:comment "Original start string of a role when it could not be normalised to a single date."@en ,
        "Texto original del inicio de un rol cuando no pudo normalizarse a una fecha única."@es ;
    rdfs:domain uc:RoleHolding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:endDateText a owl:DatatypeProperty ;
    rdfs:label "end as written"@en , "fin tal como se escribió"@es ;
    rdfs:comment "Original end string of a role when it could not be normalised to a single date."@en ,
        "Texto original del fin de un rol cuando no pudo normalizarse a una fecha única."@es ;
    rdfs:domain uc:RoleHolding ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:unitNote a owl:DatatypeProperty ;
    rdfs:label "unit note"@en , "nota de unidad"@es ;
    rdfs:comment "Unit or meaning of a financial fact's value, as noted by the contributor."@en ,
        "Unidad o significado del valor de un dato financiero, según lo anotó el colaborador."@es ;
    rdfs:domain uc:FinancialFact ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:issueLocation a owl:DatatypeProperty ;
    rdfs:label "issue location"@en , "ubicación de la inconsistencia"@es ;
    rdfs:comment "Where a data issue was found (page, table, pair of sources)."@en ,
        "Dónde se encontró la inconsistencia (página, tabla, par de fuentes)."@es ;
    rdfs:domain uc:Issue ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:recipientDerivedFrom a owl:ObjectProperty ;
    rdfs:label "recipient derived from"@en , "destinatario derivado de"@es ;
    rdfs:comment "The uc:Flow assertions from which a derived uc:ultimateRecipient link on this loan was computed."@en ,
        "Las aserciones uc:Flow a partir de las cuales se calculó un vínculo derivado uc:ultimateRecipient de este préstamo."@es ;
    rdfs:domain uc:Loan ;
    rdfs:range uc:Flow ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:nameAsReported a owl:DatatypeProperty ;
    rdfs:label "name as reported"@en , "nombre según la fuente"@es ;
    rdfs:comment "Name of the charged person as printed by the source."@en ,
        "Nombre de la persona imputada tal como lo publica la fuente."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:roleReported a owl:DatatypeProperty ;
    rdfs:label "role as reported"@en , "rol según la fuente"@es ;
    rdfs:comment "Role of the charged person as reported by the source."@en ,
        "Rol de la persona imputada según la fuente."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:allegedOffenceAdded a owl:DatatypeProperty ;
    rdfs:label "alleged offence added"@en , "hecho punible añadido"@es ;
    rdfs:comment "An offence reported as added later to the original charge. An allegation only."@en ,
        "Hecho punible que, según se informó, se añadió después a la imputación original. Es solo una alegación."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:defenceStatement a owl:DatatypeProperty ;
    rdfs:label "defence statement"@en , "posición de la defensa"@es ;
    rdfs:comment "Position of the defence as reported by the source of the charge row."@en ,
        "Posición de la defensa según la fuente de la fila de imputación."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:caseReference a owl:DatatypeProperty ;
    rdfs:label "case reference"@en , "número de causa"@es ;
    rdfs:comment "Number of the criminal case the charge belongs to (for example 89/2026)."@en ,
        "Número de la causa penal a la que pertenece la imputación (por ejemplo 89/2026)."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:detainedOn a owl:DatatypeProperty ;
    rdfs:label "detained on"@en , "detenido el"@es ;
    rdfs:comment "Date on which the person was reported detained."@en ,
        "Fecha en que, según se informó, la persona fue detenida."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:measureRequested a owl:DatatypeProperty ;
    rdfs:label "measure requested"@en , "medida solicitada"@es ;
    rdfs:comment "Procedural measure requested by the prosecution, when it differs from the measure ordered (contributor code)."@en ,
        "Medida procesal solicitada por la Fiscalía cuando difiere de la medida dictada (código del colaborador)."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:measureSource a owl:ObjectProperty ;
    rdfs:label "measure source"@en , "fuente de la medida"@es ;
    rdfs:comment "The source from which the procedural measure was taken, when it is not the row's main source."@en ,
        "Fuente de la que se tomó la medida procesal cuando no es la fuente principal de la fila."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range uc:Source ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:statusSource a owl:ObjectProperty ;
    rdfs:label "status source"@en , "fuente del estado"@es ;
    rdfs:comment "The source from which the person's current procedural status was taken."@en ,
        "Fuente de la que se tomó el estado procesal actual de la persona."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range uc:Source ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:nextHearing a owl:DatatypeProperty ;
    rdfs:label "next hearing"@en , "próxima audiencia"@es ;
    rdfs:comment "Next hearing or procedural step as reported (free text)."@en ,
        "Próxima audiencia o acto procesal según se informó (texto libre)."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:placeReported a owl:DatatypeProperty ;
    rdfs:label "place reported"@en , "lugar informado"@es ;
    rdfs:comment "Place of detention or arrest as reported (free text; may record a conflict between outlets)."@en ,
        "Lugar de reclusión o arresto según se informó (texto libre; puede consignar una discrepancia entre medios)."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:previousMeasure a owl:DatatypeProperty ;
    rdfs:label "previous measure"@en , "medida anterior"@es ;
    rdfs:comment "An earlier procedural measure that was later replaced."@en ,
        "Medida procesal anterior que luego fue sustituida."@es ;
    rdfs:domain uc:Charge ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:sourceTier a owl:DatatypeProperty ;
    rdfs:label "source tier"@en , "nivel de la fuente"@es ;
    rdfs:comment "How close to the prosecution record the assertion's source is: 'record' (a record page), 'press_linked' (a document with a URL), 'rating_or_official', 'dossier' (third-party compilation without links), 'editorial' (label supplied by the project), 'analysis' (an analyst opinion, not a sourced claim) or 'unlinked'."@en ,
        "Cercanía de la fuente al acta fiscal: 'record' (página del acta), 'press_linked' (documento con URL), 'rating_or_official' (calificadora u oficial), 'dossier' (compilación de terceros sin enlaces), 'editorial' (etiqueta puesta por el proyecto), 'analysis' (opinión de analista, no una afirmación con fuente) o 'unlinked' (sin enlace)."@es ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:alleged a owl:DatatypeProperty ;
    rdfs:label "alleged"@en , "alegado"@es ;
    rdfs:comment "true on a flow or event of the record layer whose text states conduct; it must be presented as 'the prosecution alleges' or 'Rey states'."@en ,
        "true en un flujo o evento de la capa del acta cuyo texto afirma una conducta; debe presentarse como 'la Fiscalía alega' o 'Rey declara'."@es ;
    rdfs:domain uc:Assertion ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:hidden a owl:DatatypeProperty ;
    rdfs:label "hidden"@en , "oculto"@es ;
    rdfs:comment "true on an assertion that stays in the graph but must be left out of visualisations."@en ,
        "true en una aserción que permanece en el grafo pero debe omitirse en las visualizaciones."@es ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:hiddenReason a owl:DatatypeProperty ;
    rdfs:label "reason for hiding"@en , "motivo de ocultación"@es ;
    rdfs:comment "Why the assertion is hidden."@en ,
        "Por qué se oculta la aserción."@es ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:verified a owl:DatatypeProperty ;
    rdfs:label "verified"@en , "verificado"@es ;
    rdfs:comment "true when the data editor checked the row against its source and confirmed it; false when the check did not confirm it."@en ,
        "true cuando el editor de datos cotejó la fila con su fuente y la confirmó; false cuando el cotejo no la confirmó."@es ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:verifiedMethod a owl:DatatypeProperty ;
    rdfs:label "verification method"@en , "método de verificación"@es ;
    rdfs:comment "How the row was checked (page image, OCR text, URL, script)."@en ,
        "Cómo se cotejó la fila (imagen de página, texto OCR, URL, script)."@es ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:verifiedNote a owl:DatatypeProperty ;
    rdfs:label "verification note"@en , "nota de verificación"@es ;
    rdfs:comment "The editor's remark on the check."@en ,
        "Observación del editor sobre el cotejo."@es ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:correction a owl:ObjectProperty ;
    rdfs:label "correction"@en , "corrección"@es ;
    rdfs:comment "A uc:Correction applied to this assertion."@en ,
        "Una uc:Correction aplicada a esta aserción."@es ;
    rdfs:range uc:Correction ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:correctsRow a owl:ObjectProperty ;
    rdfs:label "corrects row"@en , "corrige la fila"@es ;
    rdfs:comment "The assertion a correction was applied to."@en ,
        "La aserción a la que se aplicó la corrección."@es ;
    rdfs:domain uc:Correction ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:correctedField a owl:DatatypeProperty ;
    rdfs:label "corrected field"@en , "campo corregido"@es ;
    rdfs:comment "Name of a field changed by an editorial correction (the key used in the JSON-LD output)."@en ,
        "Nombre de un campo modificado por una corrección editorial (la clave usada en la salida JSON-LD)."@es ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:originalValue a owl:DatatypeProperty ;
    rdfs:label "original value"@en , "valor original"@es ;
    rdfs:comment "Value before an editorial correction. On an assertion it is written 'field: value'; on a uc:Correction it is the value alone."@en ,
        "Valor anterior a una corrección editorial. En una aserción se escribe 'campo: valor'; en una uc:Correction es solo el valor."@es ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:newValue a owl:DatatypeProperty ;
    rdfs:label "new value"@en , "valor nuevo"@es ;
    rdfs:comment "Value set by the correction."@en ,
        "Valor fijado por la corrección."@es ;
    rdfs:domain uc:Correction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:editorNote a owl:DatatypeProperty ;
    rdfs:label "editor note"@en , "nota del editor"@es ;
    rdfs:comment "The data editor's reason for a correction."@en ,
        "Motivo del editor de datos para una corrección."@es ;
    rdfs:range rdf:langString ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:correctionAction a owl:DatatypeProperty ;
    rdfs:label "correction action"@en , "acción de corrección"@es ;
    rdfs:comment "'set', 'set_confidence', 'add_note', 'merge_entity' or 'delete_row' (which hides the row; nothing is deleted)."@en ,
        "'set', 'set_confidence', 'add_note', 'merge_entity' o 'delete_row' (que oculta la fila; nada se borra)."@es ;
    rdfs:domain uc:Correction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:correctionStatus a owl:DatatypeProperty ;
    rdfs:label "correction status"@en , "estado de la corrección"@es ;
    rdfs:comment "'applied', or 'not applied' followed by the reason."@en ,
        "'applied' (aplicada) o 'not applied' (no aplicada) seguido del motivo."@es ;
    rdfs:domain uc:Correction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:rawField a owl:DatatypeProperty ;
    rdfs:label "raw field"@en , "campo original"@es ;
    rdfs:comment "Name of the corrected field in the contributor file."@en ,
        "Nombre del campo corregido en el archivo del colaborador."@es ;
    rdfs:domain uc:Correction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:checkedAgainst a owl:DatatypeProperty ;
    rdfs:label "checked against"@en , "cotejado con"@es ;
    rdfs:comment "What the editor compared the row with (page image, URL, script)."@en ,
        "Con qué cotejó el editor la fila (imagen de página, URL, script)."@es ;
    rdfs:domain uc:Correction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:sameOperationKey a owl:DatatypeProperty ;
    rdfs:label "same-operation key"@en , "clave de misma operación"@es ;
    rdfs:comment "Shared key of loan or flow records that describe the same operation in different sources. The records stay separate; the key only lets a reader collapse alternative reports."@en ,
        "Clave compartida por registros de préstamo o flujo que describen la misma operación en fuentes distintas. Los registros siguen separados; la clave solo permite agrupar informes alternativos."@es ;
    rdfs:domain uc:Assertion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:restates a owl:ObjectProperty ;
    rdfs:label "restates"@en , "reformula"@es ;
    rdfs:comment "The hidden flow that this event restates as a statement by the same voice, with the same provenance."@en ,
        "El flujo oculto que este evento reformula como declaración de la misma voz, con la misma procedencia."@es ;
    rdfs:domain uc:CaseEvent ;
    rdfs:range uc:Flow ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

# -----------------------------------------------------------------------------
# Terms added in v0.3.0 (20 Nov 2026): analyst opinions and the analysis graph
# -----------------------------------------------------------------------------

uc:opinionKind a owl:DatatypeProperty ;
    rdfs:label "opinion kind"@en , "tipo de opinión"@es ;
    rdfs:comment "Kind of analyst opinion: 'headline' (the main estimate), 'meaning' (what a figure does and does not mean), 'hypothesis' (a possible explanation) or 'recovery_scenario'."@en ,
        "Tipo de opinión del analista: 'headline' (estimación principal), 'meaning' (qué significa y qué no una cifra), 'hypothesis' (explicación posible) o 'recovery_scenario' (escenario de recuperación)."@es ;
    rdfs:domain uc:AnalystOpinion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:estimateLow a owl:DatatypeProperty ;
    rdfs:label "estimate (low)"@en , "estimación (baja)"@es ;
    rdfs:comment "Lower bound of an analyst estimate, in the currency given by uc:currency. An opinion, not a sourced figure."@en ,
        "Límite inferior de una estimación del analista, en la moneda indicada por uc:currency. Es una opinión, no una cifra con fuente."@es ;
    rdfs:domain uc:AnalystOpinion ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:estimateCentral a owl:DatatypeProperty ;
    rdfs:label "estimate (central)"@en , "estimación (central)"@es ;
    rdfs:comment "Central value of an analyst estimate, in the currency given by uc:currency. An opinion, not a sourced figure."@en ,
        "Valor central de una estimación del analista, en la moneda indicada por uc:currency. Es una opinión, no una cifra con fuente."@es ;
    rdfs:domain uc:AnalystOpinion ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:estimateHigh a owl:DatatypeProperty ;
    rdfs:label "estimate (high)"@en , "estimación (alta)"@es ;
    rdfs:comment "Upper bound of an analyst estimate, in the currency given by uc:currency. An opinion, not a sourced figure."@en ,
        "Límite superior de una estimación del analista, en la moneda indicada por uc:currency. Es una opinión, no una cifra con fuente."@es ;
    rdfs:domain uc:AnalystOpinion ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

uc:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en , "basada en"@es ;
    rdfs:comment "A sourced assertion that an analyst opinion rests on. The assertion keeps its own asserter, source and confidence."@en ,
        "Aserción con fuente en la que se apoya una opinión del analista. La aserción conserva su propio declarante, fuente y confianza."@es ;
    rdfs:domain uc:AnalystOpinion ;
    rdfs:range uc:Assertion ;
    rdfs:isDefinedBy <https://w3id.org/ueno-case/ont> .

<https://w3id.org/ueno-case/id/graph/analysis> a uc:AssertionGraph ;
    rdfs:label "Analyst opinions graph"@en , "Grafo de opiniones del analista"@es ;
    rdfs:comment "Named graph holding only uc:AnalystOpinion resources: estimates and interpretations by the project's analysts, linked by uc:basedOn to the sourced assertions they rest on. Never a finding of the record."@en ,
        "Grafo con nombre que contiene solo recursos uc:AnalystOpinion: estimaciones e interpretaciones de los analistas del proyecto, vinculadas por uc:basedOn a las aserciones con fuente en que se apoyan. Nunca es una conclusión del acta."@es ;
    prov:wasAttributedTo uc:Analyst .
